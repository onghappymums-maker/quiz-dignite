<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Quiz Dignité — Teste tes connaissances sur la santé menstruelle | Happy Mum's</title>
    <meta name="description" content="Quiz interactif gratuit sur la santé menstruelle et les droits des filles. 95 questions, 3 profils personnalisés. Par ONG Happy Mum's, Côte d'Ivoire." />
    <meta name="keywords" content="quiz santé menstruelle, règles, hygiène menstruelle, droits des filles, éducation menstruelle, Côte d'Ivoire, Happy Mum's, DSSR, dignité menstruelle" />
    <meta name="author" content="ONG Happy Mum's" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.quizdignite.org/" />
    <meta name="theme-color" content="#E8003D" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Quiz Dignité" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.quizdignite.org/" />
    <meta property="og:title" content="Quiz Dignité — Teste tes connaissances sur la santé menstruelle" />
    <meta property="og:description" content="Quiz interactif gratuit sur la santé menstruelle et les droits des filles. 95 questions, 3 profils personnalisés. Par ONG Happy Mum's, Côte d'Ivoire." />
    <meta property="og:image" content="https://www.quizdignite.org/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Quiz Dignité par ONG Happy Mum's — La dignité menstruelle est un droit." />
    <meta property="og:locale" content="fr_CI" />
    <meta property="og:locale:alternate" content="fr_FR" />
    <meta property="og:site_name" content="Quiz Dignité — Happy Mum's" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Quiz Dignité — Santé menstruelle & droits des filles" />
    <meta name="twitter:description" content="95 questions, 3 profils, 100% gratuit. Teste tes connaissances et découvre ton profil de santé menstruelle. Par ONG Happy Mum's 🇨🇮" />
    <meta name="twitter:image" content="https://www.quizdignite.org/og-image.png" />
    <meta name="twitter:image:alt" content="Quiz Dignité par ONG Happy Mum's" />
    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5BDM2ZEKWB"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5BDM2ZEKWB', { page_title: 'Quiz Dignité — Happy Mums', send_page_view: true });
    </script>
    <!-- Service Worker -->
    <script>
      if ('serviceWorker' in navigator && location.hostname === 'quizdignite.org') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then(r => console.log('SW OK')).catch(e => console.log('SW erreur', e));
        });
      }
    </script>
    <!-- JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [{
        "@type": "WebApplication",
        "name": "Quiz Dignité",
        "url": "https://www.quizdignite.org/",
        "description": "Quiz interactif sur la santé menstruelle et les droits des filles. 95 questions, 3 profils personnalisés. Gratuit.",
        "applicationCategory": "EducationalApplication",
        "operatingSystem": "All",
        "inLanguage": "fr",
        "isAccessibleForFree": true,
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "XOF" },
        "publisher": { "@type": "Organization", "name": "ONG Happy Mum's", "url": "https://www.quizdignite.org/" }
      }]
    }
    </script>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: #FFF4F7; }
      #root { min-height: 100vh; }
    </style>

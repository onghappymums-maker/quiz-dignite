@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap');
*,*::before,*::after{box-sizing:border-box;}
body{margin:0;overflow-x:hidden;font-family:'Nunito',sans-serif;}
.app{font-family:'Nunito',sans-serif;}
.T{font-family:'Baloo 2',sans-serif;}
.F{font-family:'Fredoka',sans-serif;}
@keyframes up{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes pop{0%{transform:scale(1)}45%{transform:scale(1.22)}100%{transform:scale(1)}}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-7px)}75%{transform:translateX(7px)}}
@keyframes pulse{0%,100%{opacity:.18}50%{opacity:.65}}
@keyframes floatUp{0%{transform:translateY(0) rotate(0deg);opacity:.22}100%{transform:translateY(-115vh) rotate(200deg);opacity:0}}
@keyframes bgA{0%{background-position:0 50%}50%{background-position:100% 50%}100%{background-position:0 50%}}
.up{animation:up .3s ease;}.pop{animation:pop .35s;}.shake{animation:shake .3s;}
.pulse{animation:pulse 2s infinite;}
button{font-family:'Nunito',sans-serif;cursor:pointer;}
.BG{position:fixed;inset:0;z-index:0;background:linear-gradient(-45deg,#FFDDE1,#FFAAB5,#FECFEF,#FFD6CC,#FFECD2,#FFB7C5);background-size:400% 400%;animation:bgA 14s ease infinite;}
.FL{position:fixed;inset:0;pointer-events:none;z-index:1;overflow:hidden;}
.fl{position:absolute;bottom:-60px;animation:floatUp linear infinite;}
.SH{position:relative;z-index:2;min-height:100vh;max-width:480px;margin:0 auto;overflow-x:hidden;}
`,T=(e,t,n,A,r,l,i)=>({q:e,answers:[t,n,A,r],correct:l,ex:i,type:"qcm"}),H=(e,t,n)=>({q:e,answers:["Vrai","Faux"],correct:t?0:1,ex:n,type:"vf"}),W=(e,t,n)=>({q:e,answers:["Mythe","Réalité"],correct:t?0:1,ex:n,type:"mr"}),gf={fille:{qcm:[T("Combien de jours dure en moyenne un cycle menstruel ?","28 jours","14 jours","7 jours","45 jours",0,"Un cycle dure en moyenne 28 jours, mais peut varier entre 21 et 35 jours."),T("Combien de jours durent les règles en général ?","1 jour","15 jours","3 à 7 jours","1 mois",2,"Les règles durent entre 3 et 7 jours. C'est différent pour chaque fille, et c'est normal !"),T("À quel âge apparaissent généralement les premières règles ?","6-8 ans","Toujours à 12 ans","18-20 ans","10-16 ans",3,"Les premières règles arrivent entre 10 et 16 ans. Un peu avant ou après, c'est tout à fait normal."),T("Combien de fois par jour faut-il changer sa protection ?","1 fois","Toutes les 4-8 heures","1 fois par semaine","Jamais",1,"Changer toutes les 4 à 8 heures évite les infections et les odeurs."),T("Peut-on faire du sport pendant ses règles ?","Oui, cela peut soulager les douleurs","Non, c'est dangereux","Seulement marcher","Non, jamais",0,"Le sport libère des endorphines qui réduisent naturellement les crampes !"),T("Qu'est-ce qu'une cup menstruelle ?","Un tampon jetable","Une boisson","Un récipient réutilisable qui recueille le sang","Un médicament",2,"La cup est en silicone, réutilisable pendant des années. Écologique et économique !"),T("Quel organe produit les ovules ?","Les ovaires","Le vagin","L'utérus","Le col de l'utérus",0,"Les ovaires produisent les ovules. Chaque mois, un ovule est libéré lors de l'ovulation."),T("La couleur du sang des règles peut-elle varier ?","Non, toujours rouge vif","Elle est toujours noire","Seulement si malade","Oui, du rouge clair au brun",3,"La couleur varie naturellement selon le flux. Tout à fait normal !"),T("Qu'est-ce que la précarité menstruelle ?","Des règles abondantes","L'absence de règles","Ne pas avoir accès aux protections hygiéniques","Des règles douloureuses",2,"La précarité menstruelle prive des milliers de filles d'éducation. ONG Happy Mum's agit !"),T("Qu'est-ce que l'endométriose ?","Des règles normales","L'absence de règles","Une infection","Une maladie où le tissu utérin pousse hors de l'utérus",3,"L'endométriose touche 1 femme sur 10. Des douleurs très intenses méritent une consultation.")],vf:[H("Les règles sont une maladie.",!1,"Les règles sont un processus naturel et normal du corps féminin. Pas une maladie !"),H("On peut tomber enceinte pendant ses règles.",!0,"C'est rare mais possible, surtout avec des cycles courts. Mieux vaut le savoir !"),H("Le sang des règles est sale et contaminé.",!1,"Le sang menstruel est du tissu utérin et du sang normal. Il n'est pas dangereux."),H("Il est normal d'avoir des règles irrégulières au début.",!0,"Les premiers cycles peuvent être irréguliers pendant 1 à 2 ans. Ton corps apprend !"),H("Se laver tous les jours pendant les règles est important.",!0,"Une bonne hygiène intime est encore plus essentielle pendant les règles."),H("Les règles durent toujours exactement 28 jours.",!1,"Un cycle varie entre 21 et 35 jours selon les femmes. Il n'y a pas de durée unique."),H("Une fille en règles peut aller à l'école normalement.",!0,"Les règles ne doivent jamais t'empêcher d'aller à l'école. Tu as ce droit !"),H("Une douleur très intense pendant les règles est toujours normale.",!1,"Une douleur intense peut indiquer une endométriose. Consulte un médecin."),H("On peut nager pendant ses règles avec une cup ou un tampon.",!0,"Avec les bonnes protections, tu peux tout faire, même nager !"),H("Les règles disparaissent définitivement à la ménopause.",!0,"La ménopause marque la fin des règles, généralement entre 45 et 55 ans.")],mr:[W("Les femmes en règles ne peuvent pas cuisiner, les plats vont tourner.",!0,"Aucune base scientifique ! Les règles n'affectent absolument pas les aliments."),W("Le sang des règles attire les animaux sauvages.",!0,"Aucune preuve scientifique. C'est un mythe infondé."),W("Se laver les cheveux pendant les règles rend malade.",!0,"Au contraire ! Une bonne hygiène est essentielle pendant les règles."),W("Une fille en règles est impure.",!0,"Les règles sont un processus naturel. Aucune femme n'est impure à cause de son cycle !"),W("Les douleurs menstruelles intenses sont normales et il faut les endurer.",!0,"Une douleur intense peut signaler l'endométriose. Ne souffre pas en silence !"),W("Les premières règles signifient qu'une fille est prête pour le mariage.",!0,"Les premières règles sont un signe de puberté, PAS de maturité maritale !"),W("Certains endroits en Côte d'Ivoire offrent des protections gratuites.",!1,"Vrai ! ONG Happy Mum's installe des Box de Dignité à Abidjan et Bouaké."),W("Les règles rendent les femmes moins intelligentes.",!0,"FAUX ! Les règles n'affectent absolument pas les capacités intellectuelles."),W("Avoir ses premières règles à 10 ans est anormal.",!0,"La puberté peut commencer entre 8 et 16 ans. 10 ans est dans la norme."),W("Après les premières règles, une grossesse est possible.",!1,"Oui, c'est la réalité ! Important à savoir pour se protéger.")],violence:[T("La violence, c'est seulement quand il y a des coups ?","Non — elle peut être physique, verbale, psychologique ou sexuelle","Oui, sans coups ce n'est pas de la violence","Seulement si ça laisse des traces","Ça dépend",0,"La violence prend de nombreuses formes. Les blessures invisibles sont souvent les plus profondes."),H("Si tu te sens mal à l'aise avec quelqu'un, tu dois ignorer ce ressenti.",!1,"Ton ressenti est un signal d'alarme naturel. Si quelqu'un te met mal à l'aise, appelle le 116 — gratuit, 24h/24."),T("Un adulte te touche sur des parties intimes et te dit 'garde ça entre nous'. Tu fais quoi ?","Tu gardes le secret","Tu penses avoir mal compris","Tu en parles immédiatement à un adulte de confiance ou tu appelles le 116","Tu attends",2,"Personne n'a le droit de toucher ton corps sans ton accord. Ce n'est jamais ta faute."),W("Si quelqu'un te fait du mal, c'est forcément un inconnu.",!0,"Dans la majorité des cas, la violence vient d'une personne connue. Ce n'est pas de ta faute."),H("Le silence veut dire 'oui'.",!1,"Le consentement doit être clair et libre. L'absence de 'non' ne veut pas dire 'oui'."),T("Quelqu'un t'envoie des messages qui te font peur. Tu fais quoi ?","Tu réponds pour être polie","Tu effaces tout","Tu en parles à tes amis seulement","Tu ne réponds pas, tu gardes les preuves et tu en parles à un adulte",3,"Ne jamais effacer les preuves. Appelle le 116 — gratuit et confidentiel."),W("C'est ta faute si quelqu'un te fait du mal.",!0,"La responsabilité est toujours du côté de l'agresseur. Jamais de la victime."),H("Une blague qui te met mal à l'aise est acceptable si tout le monde rit.",!1,"Le respect passe aussi par les mots. Ton malaise est valide même si les autres rient."),T("Si tu as peur de parler, qu'est-ce qui peut t'aider ?","Écrire ce que tu ressens ou appeler le 116 anonymement","Attendre que ça se règle seul","Garder ça pour toi","En parler uniquement sur les réseaux",0,"Le 116 est gratuit, disponible 24h/24. Tu peux parler à ton rythme."),W("Certaines victimes parlent des années après — c'est qu'elles mentaient.",!0,"Chacun parle à son rythme. La peur ou la honte peuvent retarder la parole.")]},garcon:{qcm:[T("Les règles, qu'est-ce que c'est ?","Une maladie grave","Un processus naturel du corps féminin","Une chose honteuse","Un choix",1,"Les règles sont un phénomène biologique normal. Comprendre cela fait de toi un meilleur allié."),T("Durée moyenne d'un cycle menstruel ?","7 jours","14 jours","28 jours","60 jours",2,"Comprendre le cycle aide à être respectueux envers les femmes de ta vie."),T("Qu'est-ce que la précarité menstruelle ?","Des règles douloureuses","Ne pas avoir accès aux protections","Trop de règles","Pas de règles",1,"Des millions de filles ne peuvent pas acheter des protections. C'est un problème de droits humains."),T("Comment soutenir une fille pendant ses règles ?","Se moquer","L'ignorer","Être respectueux et empathique","Lui dire que c'est sa faute",2,"L'empathie et le respect font de toi un vrai allié."),T("Pourquoi des filles manquent-elles l'école pendant leurs règles ?","Elles n'aiment pas l'école","Manque de protections et toilettes adaptées","Les règles les rendent paresseuses","C'est interdit",1,"Le manque d'infrastructures prive des milliers de filles d'éducation. C'est injuste !"),T("Qu'est-ce que le consentement ?","Faire ce qu'on veut","Accepter librement et sans pression","Obéir toujours","Donner de l'argent",1,"Le consentement c'est dire OUI librement. Sans pression. C'est la base absolue."),T("Pourquoi parler des règles concerne aussi les garçons ?","C'est un sujet de filles","Cela concerne toute la société","C'est tabou","Pas besoin",1,"Briser le tabou c'est l'affaire de tous. Un garçon informé est un meilleur citoyen."),T("Que signifie respecter le corps d'une fille ?","La surveiller","Respecter ses choix et son espace personnel","Décider pour elle","L'ignorer",1,"Chaque personne est maître de son corps. Le respect c'est la base."),T("Quel est le rôle d'un frère respectueux ?","Contrôler sa soeur","Protéger et soutenir avec bienveillance","Décider à sa place","L'ignorer",1,"Un frère bienveillant crée un espace sûr pour sa soeur. C'est une vraie force."),T("Qu'est-ce qu'une MGF ?","Un traitement médical","Une pratique néfaste et illégale","Un rite inoffensif","Un médicament",1,"Les MGF sont des violations graves des droits humains, interdites dans de nombreux pays.")],vf:[H("Se moquer d'une fille qui a ses règles est acceptable.",!1,"Se moquer cause de la honte. Sois un allié, pas un obstacle."),H("Les garçons peuvent apprendre des choses utiles sur les règles.",!0,"Comprendre le corps des femmes rend les garçons plus empathiques et respectueux."),H("Une fille en règles est moins intelligente ou moins capable.",!1,"Les règles n'affectent pas les capacités intellectuelles. C'est faux et blessant."),H("Le mariage précoce des filles est une violation de leurs droits.",!0,"L'âge légal du mariage est 18 ans en Côte d'Ivoire."),H("Un garçon qui aide sa soeur avec ses protections est moins masculin.",!1,"Au contraire, c'est un signe de maturité et de respect."),H("Les femmes ont le droit de décider de leur propre corps.",!0,"L'autodétermination corporelle est un droit fondamental."),H("Parler des règles rend un garçon moins masculin.",!1,"La connaissance n'a pas de genre. Un garçon informé est un meilleur citoyen."),H("Un garçon doit toujours respecter le non d'une fille.",!0,"Le consentement est non négociable. Non signifie non. Toujours."),H("Les violences contre les femmes ne concernent que les femmes.",!1,"La lutte contre les violences est l'affaire de toute la société."),H("Des garçons peuvent être des alliés dans la lutte pour les droits des filles.",!0,"Absolument ! Les mouvements pour l'égalité ont besoin des garçons.")],mr:[W("Les garçons n'ont pas besoin de comprendre les règles.",!0,"Comprendre le corps féminin aide à être respectueux et responsable."),W("En Côte d'Ivoire, le mariage légal est fixé à 18 ans pour tous.",!1,"Vrai ! Le Code civil ivoirien fixe l'âge du mariage à 18 ans pour les deux sexes."),W("Si une fille dit non, c'est qu'elle veut dire oui.",!0,"Non signifie non. Toujours. Sans exception."),W("Des garçons peuvent être alliés des droits des filles.",!1,"Vrai ! Les mouvements pour l'égalité ont besoin des garçons."),W("Le mariage précoce protège les filles.",!0,"Au contraire, il prive les filles d'éducation et de liberté. C'est une violence."),W("Les violences faites aux femmes concernent toute la société.",!1,"Vrai ! La lutte contre les violences est l'affaire de tous."),W("Un garçon qui exprime ses émotions est faible.",!0,"Les émotions sont humaines. Un garçon qui les exprime est plus empathique."),W("ONG Happy Mum's travaille pour les droits des filles depuis 2019.",!1,"Vrai ! Happy Mum's milite pour la dignité menstruelle en Côte d'Ivoire."),W("Les règles sont un sujet honteux qu'on ne doit jamais évoquer.",!0,"Briser ce tabou c'est protéger les filles. La connaissance est un acte de respect."),W("Forcer quelqu'un à faire quelque chose contre sa volonté est un crime.",!1,"Vrai ! La contrainte est punie par la loi. Le consentement est un droit fondamental.")],violence:[H("Un garçon ne peut pas être victime de gestes déplacés.",!1,"Les violences peuvent toucher tout le monde, peu importe le genre. Ton corps t'appartient."),T("Quelqu'un te touche et ça te met mal à l'aise. C'est quoi la bonne réaction ?","Tu fais comme si de rien n'était","Tu te dis que c'est normal","Tu supports en silence","Tu dis clairement que ça ne te plaît pas et tu en parles à quelqu'un",3,"Ton corps t'appartient. Tu peux appeler le 116 — gratuit, confidentiel, 24h/24."),W("Un garçon fort ne parle pas de ce qu'il vit.",!0,"Se taire ne protège pas. Parler est un acte de courage, pas une faiblesse."),T("Un adulte te touche sur des parties intimes et te dit 'c'est notre secret'. Tu fais quoi ?","Tu en parles immédiatement à un adulte de confiance ou tu appelles le 116","Tu gardes le secret","Tu penses que c'est normal","Tu attends",0,"Ton corps t'appartient. Un adulte bienveillant ne fait jamais ça. Ce n'est pas ta faute."),H("Si une fille dit non et que tu insistes, c'est juste de la persévérance.",!1,"Insister après un refus est une forme de pression et de violence. Non veut dire non."),W("Une fille peut changer d'avis à tout moment, même si elle avait dit oui avant.",!1,"Le consentement n'est jamais acquis définitivement. Il peut être retiré à tout moment."),T("Tu vois un ami dans une situation injuste ou dangereuse. Tu fais quoi ?","Tu ignores","Tu te moques","Tu l'encourages à en parler à un adulte","Tu règles ça entre vous",2,"Soutenir un ami en difficulté c'est une vraie force."),H("Parler de ce qu'on vit, c'est être faible.",!1,"Demander de l'aide est l'un des actes les plus courageux. Tu peux appeler le 116."),T("Tu reçois des messages d'un adulte qui te demande de garder ça secret. Tu fais quoi ?","Tu gardes le secret","Tu en parles immédiatement à un adulte de confiance ou tu appelles le 116","Tu bloques et tu oublies","Tu attends",1,"Ne jamais garder ce type de secret. Un adulte bienveillant ne demande pas ça."),W("Les garçons qui parlent de leurs problèmes perdent le respect des autres.",!0,"Au contraire, savoir exprimer ce qu'on vit inspire confiance et respect.")]},parent:{qcm:[T("À quel âge faut-il parler des règles à sa fille ?","Après les premières règles","Avant les premières règles, dès 8-9 ans","À 18 ans","Jamais",1,"Parler des règles avant qu'elles arrivent prépare la fille et réduit la peur et la honte."),T("Comment réagir quand sa fille a ses premières règles ?","La gronder","L'ignorer","Accueillir avec bienveillance et expliquer","Lui dire que c'est honteux",2,"La première réaction d'un parent marque la relation de la fille avec son corps pour longtemps."),T("Quel signal doit alerter un parent ?","Des règles régulières","Une fille qui cache ses règles par honte","Des douleurs légères","Des règles à 12 ans",1,"Une fille qui cache ses règles par honte a besoin d'un espace de parole bienveillant."),T("Comment créer un espace de dialogue sur les règles ?","Attendre qu'elle pose des questions","Initier la conversation avec calme et sans jugement","Lui donner un livre","Lui interdire d'en parler",1,"Les parents qui parlent ouvertement de la santé menstruelle protègent mieux leurs enfants."),T("Que faire si une fille souffre beaucoup pendant ses règles ?","Lui dire d'endurer","La consulter chez un médecin","L'ignorer","Lui donner n'importe quel médicament",1,"Une douleur intense peut signaler une endométriose. Une consultation médicale est indispensable."),T("Comment parler des règles aux garçons de la famille ?","Leur interdire d'en parler","Les éduquer avec respect et bienveillance","Ce n'est pas leur affaire","Les laisser se moquer",1,"Un frère ou un père informé est un allié protecteur pour les filles de la famille."),T("Qu'est-ce qu'une Box de Dignité ?","Une boîte cadeau","Un dispositif offrant des protections hygiéniques gratuitement","Un médicament","Une boutique",1,"ONG Happy Mum's installe des Box de Dignité dans des établissements partenaires à Abidjan et Bouaké."),T("Quel est le signe que votre enfant a besoin de soutien ?","Il mange normalement","Il refuse l'école pendant ses règles","Il dort bien","Il a des amis",1,"L'absentéisme menstruel est un signal fort."),T("L'éducation menstruelle à l'école permet de :","Perdre du temps","Réduire l'absentéisme scolaire des filles","Créer des problèmes","Rien de spécial",1,"Une fille informée et équipée ne manque pas l'école à cause de ses règles !"),T("Qu'est-ce que la précarité menstruelle ?","Des règles douloureuses","Ne pas avoir accès aux protections hygiéniques","Des règles irrégulières","La ménopause précoce",1,"Des millions de filles manquent l'école faute de protections. ONG Happy Mum's agit chaque jour.")],vf:[H("Il faut attendre que la fille pose des questions pour parler des règles.",!1,"Les parents doivent initier la conversation avant les premières règles."),H("Les garçons aussi doivent être éduqués sur la santé menstruelle.",!0,"Un garçon éduqué devient un allié respectueux. L'éducation concerne toute la famille."),H("La honte des règles peut empêcher une fille de demander de l'aide.",!0,"Le silence et la honte mettent les filles en danger."),H("L'éducation menstruelle à l'école perturbe les élèves.",!1,"Elle réduit l'absentéisme, améliore la confiance et protège les filles."),H("Un éducateur peut normaliser les règles en classe.",!0,"Aborder le sujet avec calme brise le tabou et protège les élèves."),H("Les premières règles signifient qu'une fille est prête pour le mariage.",!1,"Les premières règles sont un signe de puberté, pas de maturité maritale."),H("Une fille en règles peut participer à toutes les activités scolaires.",!0,"Les règles ne sont pas un handicap. Avec les bonnes protections, une fille peut tout faire."),H("Des douleurs très intenses pendant les règles sont toujours normales.",!1,"Des douleurs intenses peuvent indiquer une endométriose. Une consultation est nécessaire."),H("Parler des règles en famille protège les filles des grossesses précoces.",!0,"L'éducation menstruelle en famille réduit les risques de grossesses non désirées."),H("Toutes les filles en Côte d'Ivoire ont accès aux protections hygiéniques.",!1,"La précarité menstruelle est réelle. ONG Happy Mum's travaille chaque jour pour y remédier.")],mr:[W("Il vaut mieux ne pas parler des règles aux enfants pour les préserver.",!0,"Au contraire, l'ignorance crée de la peur. Parler protège et rassure."),W("Une éducatrice peut aborder les règles en classe sans créer de problèmes.",!1,"Avec les bons outils pédagogiques, ce sujet peut être abordé sereinement."),W("Les garçons qui connaissent les règles deviennent irrespectueux.",!0,"La connaissance crée le respect. Un garçon informé est un meilleur allié."),W("Les filles qui ont mal pendant leurs règles font semblant.",!0,"La douleur menstruelle est réelle. La minimiser peut retarder un diagnostic important."),W("L'absentéisme scolaire lié aux règles est répandu en Afrique.",!1,"Des millions de filles manquent l'école à cause de leurs règles chaque année."),W("Un parent qui parle de règles à son fils lui donne de mauvaises idées.",!0,"L'éducation donne des outils de respect. Le silence est bien plus dangereux."),W("Les filles de familles ouvertes sur les règles s'en sortent mieux.",!1,"Oui ! L'ouverture familiale protège les filles et renforce leur réussite scolaire."),W("Les enseignants ne sont pas qualifiés pour parler de santé menstruelle.",!0,"Avec une formation simple, tout éducateur peut aborder ce sujet."),W("En Côte d'Ivoire, des ressources existent pour éduquer sur les règles.",!1,"Vrai ! ONG Happy Mum's propose des outils. Contactez-les : 07 13 51 26 98."),W("Parler des règles à la maison suffit, l'école n'a pas à s'en mêler.",!0,"L'éducation menstruelle est plus efficace quand elle est renforcée à la maison ET à l'école.")],violence:[H("Un enfant qui ne pleure pas après une violence n'a pas vraiment été blessé.",!1,"Les réactions au trauma sont très variées. Le silence ne signifie pas l'absence de souffrance."),T("Un élève vous confie avoir été touché de façon inappropriée. Quelle est votre première action ?","Écouter sans juger, rassurer et alerter les autorités","Confronter immédiatement la personne accusée","Attendre d'avoir plus de preuves","En parler aux collègues",0,"Confronter l'accusé peut mettre l'enfant en danger. L'écoute et l'alerte sont les priorités absolues."),W("Les violences sexuelles sur enfants sont commises principalement par des inconnus.",!0,"Dans plus de 70% des cas, l'agresseur est connu de l'enfant : famille, voisinage, entourage proche."),T("Un parent vous dit que son enfant exagère. Que faites-vous ?","Vous lui donnez raison","Vous convoquez l'enfant devant le parent","Vous attendez que l'enfant parle à nouveau","Vous expliquez que minimiser la parole d'un enfant peut aggraver sa situation",3,"L'enfant doit sentir qu'il sera cru."),H("Si un enfant revient sur ce qu'il a dit, c'est qu'il mentait.",!1,"Se rétracter est très courant chez les victimes, souvent par peur ou pression."),T("Une élève porte des vêtements longs même en pleine chaleur. Que pensez-vous ?","Elle veut se faire remarquer","Ce n'est pas votre rôle","C'est peut-être un signal de blessures cachées à observer avec bienveillance","Elle a froid",2,"Les changements physiques ou vestimentaires inhabituels méritent une attention bienveillante."),W("Un enfant bien élevé dans une bonne famille ne peut pas être victime de violence.",!0,"Les violences touchent tous les milieux. Le statut social ne protège pas."),H("Parler de violences avec des enfants peut leur donner des idées.",!1,"Au contraire, éduquer les enfants à reconnaître les violences les protège."),T("Un enfant agressif en classe depuis quelques semaines. Quelle est la meilleure approche ?","Le sanctionner immédiatement","Chercher à comprendre ce changement avec bienveillance","Ignorer","En informer uniquement les parents",1,"Un changement soudain de comportement peut signaler une souffrance cachée."),H("Le rôle de l'éducateur s'arrête à l'enseignement. La protection des enfants, c'est la police.",!1,"L'éducateur est souvent le premier adulte de confiance d'un enfant. Son rôle de signalement est reconnu par la loi.")]}},mf=[T("Que faire en cas de danger immédiat ?","Attendre","Appeler le 110","Se cacher sans rien dire","Ignorer",1,"Le 110 (Police Secours) permet de joindre rapidement les autorités. N'hésite jamais !"),T("Quel numéro appeler en cas de violence ou besoin d'aide ?","1308","110","101","15",0,"Le 1308 est gratuit et disponible 24h/24. Tu peux parler à quelqu'un qui peut t'aider."),T("Peut-on appeler un numéro d'urgence sans crédit téléphonique ?","Oui, toujours gratuit","Non, il faut du crédit","Seulement le 15","Seulement en ville",0,"Les numéros d'urgence sont accessibles même sans crédit téléphonique."),T("Si tu as peur ou que quelqu'un te fait du mal, tu dois :","Garder le silence","Demander de l'aide ou appeler le 1308","Attendre que ça passe","En parler sur les réseaux",1,"Parler est une façon de se protéger. Jamais de honte à demander de l'aide !"),T("Faire de faux appels aux numéros d'urgence, c'est :","Amusant","Dangereux et illégal","Normal","Sans conséquences",1,"Un faux appel peut empêcher d'aider une personne en danger. C'est un acte grave.")],hf=[{q:"Explique le cycle menstruel en 1 minute.",rep:"Chaque mois, le corps prépare l'utérus pour une possible grossesse. Si aucun bébé ne se forme, l'utérus se renouvelle : ce sont les règles. Cela dure 3 à 7 jours et se répète environ tous les 28 jours.",isDefi:!0},{q:"Cite 3 bonnes pratiques d'hygiène pendant les règles.",rep:`1. Changer sa protection toutes les 4-8 heures.
2. Se laver avec eau et savon doux matin et soir.
3. Bien se sécher après le lavage pour éviter les infections.`,isDefi:!0},{q:"Comment expliquer les règles à un enfant de 10 ans ?",rep:"Les femmes ont un corps qui se prépare chaque mois à accueillir un bébé. Quand il n'y a pas de bébé, le corps se renouvelle. Ça s'appelle les règles. Ce n'est pas une maladie.",isDefi:!0},{q:"Que dire à une fille qui a honte de ses règles ?",rep:"Tes règles sont normales et naturelles. Elles ne font pas de toi quelqu'un d'impur. Toutes les femmes les ont. Tu peux en parler, tu n'as rien à cacher.",isDefi:!0},{q:"Comment réagir si une élève demande une protection en urgence ?",rep:"Avoir une trousse de protections disponibles. Répondre avec discrétion et bienveillance. Orienter vers l'infirmerie si nécessaire. Ne jamais humilier ni exposer l'élève.",isDefi:!0}],xo={fille:[{id:"f1",icon:"🌸",name:"Fleur de Dignité"},{id:"f2",icon:"🩸",name:"Experte du Cycle"},{id:"f3",icon:"💬",name:"Briseuse de Tabous"},{id:"f4",icon:"🔦",name:"Lumière du Savoir"},{id:"f5",icon:"💪",name:"Fille Invincible"},{id:"f6",icon:"🌍",name:"Ambassadrice"},{id:"f7",icon:"🤝",name:"Voix des Filles"}],garcon:[{id:"g1",icon:"🦁",name:"Gardien du Respect"},{id:"g2",icon:"🤝",name:"Allié de la Dignité"},{id:"g3",icon:"👊",name:"Briseur de Préjugés"},{id:"g4",icon:"💡",name:"Éclaireur du Savoir"},{id:"g5",icon:"⚽",name:"Champion Empathie"},{id:"g6",icon:"🌍",name:"Ambassadeur"},{id:"g7",icon:"🛡️",name:"Protecteur Bienveillant"}],parent:[{id:"p1",icon:"❤️",name:"Cœur de Famille"},{id:"p2",icon:"📖",name:"Guide Bienveillant"},{id:"p3",icon:"🌱",name:"Semeur de Confiance"},{id:"p4",icon:"🏫",name:"Éducateur Engagé"},{id:"p5",icon:"🔑",name:"Clé du Dialogue"},{id:"p6",icon:"🌍",name:"Leader Changement"},{id:"p7",icon:"✨",name:"Source Inspiration"}]},ko=[{icon:"🌱",label:"Débutant(e)",min:0},{icon:"📚",label:"Intermédiaire",min:150},{icon:"🌟",label:"Expert(e)",min:400},{icon:"🏆",label:"Champion(ne)",min:800}],vf=e=>[...ko].reverse().find(t=>e>=t.min)||ko[0],yf=[{cats:[{id:"hygiene",e:"🧼",label:"Hygiène",color:a.blue,bg:a.blueSoft},{id:"protection",e:"🌸",label:"Protection",color:a.rose,bg:a.roseSoft},{id:"emotions",e:"💛",label:"Émotions",color:a.amber,bg:a.amberSoft}],items:[{id:1,e:"🧼",l:"Savon",c:"hygiene"},{id:2,e:"💧",l:"Mains propres",c:"hygiene"},{id:3,e:"🚿",l:"Douche",c:"hygiene"},{id:4,e:"📦",l:"Serviette",c:"protection"},{id:5,e:"🩲",l:"Culotte",c:"protection"},{id:6,e:"🔵",l:"Coupe menstruelle",c:"protection"},{id:7,e:"😊",l:"La joie",c:"emotions"},{id:8,e:"😢",l:"Tristesse",c:"emotions"},{id:9,e:"😴",l:"Fatigue",c:"emotions"}]},{cats:[{id:"hygiene",e:"🧼",label:"Hygiène",color:a.blue,bg:a.blueSoft},{id:"protection",e:"🌸",label:"Protection",color:a.rose,bg:a.roseSoft},{id:"emotions",e:"💛",label:"Émotions",color:a.amber,bg:a.amberSoft},{id:"corps",e:"❤️",label:"Mon Corps",color:a.red,bg:a.redSoft}],items:[{id:1,e:"🧼",l:"Le savon",c:"hygiene"},{id:2,e:"💧",l:"Se laver les mains",c:"hygiene"},{id:3,e:"🚿",l:"La douche",c:"hygiene"},{id:4,e:"📦",l:"Serviette hygiénique",c:"protection"},{id:5,e:"🩲",l:"Culotte menstruelle",c:"protection"},{id:6,e:"🧻",l:"Tissu propre",c:"protection"},{id:7,e:"😊",l:"La joie",c:"emotions"},{id:8,e:"💪",l:"La fierté",c:"emotions"},{id:9,e:"😴",l:"La fatigue",c:"emotions"},{id:10,e:"💗",l:"L'utérus",c:"corps"},{id:11,e:"🌺",l:"La puberté",c:"corps"},{id:12,e:"🩸",l:"Les règles",c:"corps"}]},{cats:[{id:"hygiene",e:"🧼",label:"Hygiène",color:a.blue,bg:a.blueSoft},{id:"protection",e:"🌸",label:"Protection",color:a.rose,bg:a.roseSoft},{id:"emotions",e:"💛",label:"Émotions",color:a.amber,bg:a.amberSoft},{id:"corps",e:"❤️",label:"Mon Corps",color:a.red,bg:a.redSoft},{id:"habits",e:"⭐",label:"Bonnes Habitudes",color:a.teal,bg:a.tealSoft}],items:[{id:1,e:"🧼",l:"Le savon",c:"hygiene"},{id:2,e:"💧",l:"Se laver les mains",c:"hygiene"},{id:3,e:"🚿",l:"La douche",c:"hygiene"},{id:4,e:"👕",l:"Vêtements propres",c:"hygiene"},{id:5,e:"📦",l:"Serviette hygiénique",c:"protection"},{id:6,e:"🩲",l:"Culotte menstruelle",c:"protection"},{id:7,e:"🧻",l:"Tissu propre",c:"protection"},{id:8,e:"🔵",l:"Coupe menstruelle",c:"protection"},{id:9,e:"😊",l:"La joie",c:"emotions"},{id:10,e:"😢",l:"La tristesse",c:"emotions"},{id:11,e:"😴",l:"La fatigue",c:"emotions"},{id:12,e:"💪",l:"La fierté",c:"emotions"},{id:13,e:"💗",l:"L'utérus",c:"corps"},{id:14,e:"🌺",l:"La puberté",c:"corps"},{id:15,e:"📏",l:"La croissance",c:"corps"},{id:16,e:"🩸",l:"Les règles",c:"corps"},{id:17,e:"🌙",l:"Bien dormir",c:"habits"},{id:18,e:"🥗",l:"Bien manger",c:"habits"},{id:19,e:"🏃",l:"Faire du sport",c:"habits"},{id:20,e:"💬",l:"En parler",c:"habits"}]}],Sf=[[{id:"tete",label:"La Tête",icon:"😊",color:a.rose,info:"Ta tête pense et ressent ! Tu peux avoir des maux de tête pendant les règles. Bois de l'eau. 💧"},{id:"ventre",label:"Le Ventre",icon:"🌺",color:a.coral,info:"Ton ventre abrite l'utérus. Il peut faire mal pendant les règles — une bouillotte aide ! 💪"},{id:"jambes",label:"Les Jambes",icon:"🌈",color:a.green,info:"Tes jambes te portent partout ! Marcher aide à réduire les douleurs. 🎶"}],[{id:"tete",label:"La Tête",icon:"😊",color:a.rose,info:"Ta tête pense, rêve et ressent ! Pendant les règles, tu peux avoir des maux de tête. Bois de l'eau et repose-toi. 💧"},{id:"poitrine",label:"La Poitrine",icon:"💗",color:a.purple,info:"Ta poitrine se développe pendant la puberté. Elle peut être sensible — c'est tout à fait normal. 🌸"},{id:"ventre",label:"Le Ventre",icon:"🌺",color:a.coral,info:"Ton ventre abrite l'utérus — un organe incroyable ! Il prépare ton cycle chaque mois. Une bouillotte aide. 💪"},{id:"bras",label:"Les Bras",icon:"💪",color:a.blue,info:"Tes bras te donnent la force de prendre soin de toi. Le sport peut réduire les douleurs ! 🌟"},{id:"jambes",label:"Les Jambes",icon:"🌈",color:a.green,info:"Tes jambes te portent partout ! Marcher, danser, jouer — ton corps est fait pour bouger librement. 🎶"}],[{id:"tete",label:"La Tête",icon:"😊",color:a.rose,info:"Ta tête pense, rêve et ressent ! Les hormones du cycle peuvent influencer ton humeur. C'est normal et passager. 💧"},{id:"poitrine",label:"La Poitrine",icon:"💗",color:a.purple,info:"Ta poitrine se développe pendant la puberté sous l'effet des hormones. Elle peut être sensible avant les règles. 🌸"},{id:"ventre",label:"Le Ventre",icon:"🌺",color:a.coral,info:"Ton ventre abrite l'utérus. Les douleurs sont normales mais une bouillotte aide. Si très intenses, consulte un médecin. 💪"},{id:"bras",label:"Les Bras",icon:"💪",color:a.blue,info:"Tes bras te donnent la force ! Le sport léger pendant les règles peut réduire les douleurs grâce aux endorphines. 🌟"},{id:"jambes",label:"Les Jambes",icon:"🌈",color:a.green,info:"Tes jambes te portent partout ! Marcher 20 minutes par jour améliore ton bien-être menstruel. 🎶"},{id:"uterus",label:"L'Utérus",icon:"🫁",color:a.red,info:"L'utérus est un organe en forme de poire dans ton bas-ventre. Chaque mois, il prépare un nid. Si pas de grossesse, il se nettoie — c'est tes règles ! 💗"},{id:"ovaires",label:"Les Ovaires",icon:"🌸",color:a.amber,info:"Tes ovaires produisent des ovules et des hormones comme les œstrogènes. Ce sont eux qui déclenchent ton cycle ! ✨"}]],xf=[[{id:1,e:"🩸",l:"Mes règles"},{id:2,e:"🧼",l:"Hygiène"},{id:3,e:"💧",l:"S'hydrater"},{id:4,e:"😊",l:"La joie"}],[{id:1,e:"🩸",l:"Mes règles"},{id:2,e:"🧼",l:"Hygiène"},{id:3,e:"💧",l:"S'hydrater"},{id:4,e:"📦",l:"Protection"},{id:5,e:"😊",l:"La joie"},{id:6,e:"💪",l:"Ma force"}],[{id:1,e:"🩸",l:"Mes règles"},{id:2,e:"🧼",l:"Hygiène"},{id:3,e:"💧",l:"S'hydrater"},{id:4,e:"📦",l:"Protection"},{id:5,e:"😊",l:"La joie"},{id:6,e:"💪",l:"Ma force"},{id:7,e:"💬",l:"En parler"},{id:8,e:"🌺",l:"Puberté"}]],Rn=[{e:"💧",l:"L'eau",good:!0,why:"S'hydrater réduit les crampes. 8 verres par jour ! 💧"},{e:"🫚",l:"Le gingembre",good:!0,why:"Anti-inflammatoire naturel ! En tisane, il soulage les douleurs. 🌿"},{e:"🥬",l:"Les épinards",good:!0,why:"Riches en fer, ils compensent le sang perdu. 💪"},{e:"🍌",l:"La banane",good:!0,why:"Le magnésium détend les muscles et réduit les crampes. 🌟"},{e:"🍫",l:"Chocolat noir",good:!0,why:"Riche en magnésium (70%+). Un carré pour se faire du bien ! 🍫"},{e:"🌿",l:"La tisane",good:!0,why:"Camomille, menthe, gingembre… Chaleur et apaisement. 🫖"},{e:"🫘",l:"Les lentilles",good:!0,why:"Riches en fer et protéines — de l'énergie ! 💛"},{e:"🥤",l:"Le soda",good:!1,why:"Sucre et bulles provoquent ballonnements et douleurs."},{e:"☕",l:"Trop de café",good:!1,why:"La caféine en excès intensifie les crampes. Maximum 1 tasse !"},{e:"🍟",l:"Les frites",good:!1,why:"Les aliments trop gras aggravent les ballonnements."},{e:"🧂",l:"Trop de sel",good:!1,why:"Le sel en excès provoque des gonflements."},{e:"🍬",l:"Les bonbons",good:!1,why:"Le sucre rapide = pic d'énergie puis chute. Mieux vaut un fruit !"}],kf=[{foods:Rn.slice(0,3).concat(Rn.slice(7,10)),timer:20},{foods:Rn.slice(0,5).concat(Rn.slice(7,11)),timer:15},{foods:Rn,timer:10}],Ft=[{id:1,e:"🩸",t:"Phase des règles",j:"Jours 1–5",c:a.red,bg:a.redSoft,info:"Ton corps se nettoie. Repose-toi, bois chaud, prends soin de toi. 💗"},{id:2,e:"🌱",t:"Phase folliculaire",j:"Jours 6–13",c:a.green,bg:a.greenSoft,info:"Ton énergie revient ! Tu te sens créative et pleine de vitalité. 🌟"},{id:3,e:"🌺",t:"L'ovulation",j:"Vers le jour 14",c:a.rose,bg:a.roseSoft,info:"Ton corps est au pic de sa vitalité. Tu te sens confiante. Profite ! 🌸"},{id:4,e:"🌙",t:"Phase lutéale",j:"Jours 15–28",c:a.purple,bg:a.purpleSoft,info:"Ton corps se calme. Tu peux te sentir plus introspective. C'est normal. 🫶"}],Hn=[{phaseId:1,symptom:"Crampes et fatigue",e:"😣"},{phaseId:2,symptom:"Énergie et créativité",e:"⚡"},{phaseId:3,symptom:"Confiance maximale",e:"💪"},{phaseId:4,symptom:"Besoin de repos",e:"🌙"}],vl=[{ctx:"🏫",q:"Tu as tes règles à l'école sans protection. Que fais-tu ?",opts:[{t:"Je rentre chez moi sans rien dire",ok:!1,exp:"Partir seule sans prévenir crée de l'inquiétude. Mieux vaut demander de l'aide à un adulte."},{t:"Je demande à une enseignante ou à l'infirmerie",ok:!0,exp:"Parfait ! Les adultes de l'école sont là pour t'aider. Aucune honte. 🌸"},{t:"J'attends toute la journée sans rien faire",ok:!1,exp:"Attendre sans agir peut te causer beaucoup d'inconfort."}]},{ctx:"😣",q:"Tu as de fortes douleurs de ventre pendant tes règles. Que fais-tu ?",opts:[{t:"Je prends des médicaments sans en parler à un adulte",ok:!1,exp:"Il vaut mieux consulter un adulte avant de prendre des médicaments."},{t:"Bouillotte chaude sur le ventre + repos",ok:!0,exp:"Bravo ! La chaleur détend les muscles et soulage. 💪"},{t:"Je fais du sport intense pour ignorer la douleur",ok:!1,exp:"Le sport léger peut aider, mais pas en cas de forte douleur."}]},{ctx:"👯",q:"Ton amie a peur d'avoir ses règles pour la 1ère fois. Que lui dis-tu ?",opts:[{t:"C'est horrible, tu verras !",ok:!1,exp:"Ta peur amplifie la sienne. Sois douce et rassurante."},{t:"C'est naturel, ça ne dure pas longtemps, je suis là",ok:!0,exp:"Super ! Des mots doux et vrais, c'est être une vraie amie. 🌸"},{t:"Je change de sujet parce que c'est gênant",ok:!1,exp:"Éviter le sujet laisse ton amie seule avec sa peur."}]},{ctx:"📅",q:"Tes règles n'arrivent pas depuis 2 mois. Que fais-tu ?",opts:[{t:"Je ne dis rien et j'attends encore",ok:!1,exp:"Un cycle irrégulier peut avoir plusieurs causes. Il est important d'en parler à un médecin."},{t:"Je fais des recherches sur internet toute seule",ok:!1,exp:"Internet peut être trompeur. Parle à un adulte de confiance."},{t:"J'en parle à un adulte de confiance ou un médecin",ok:!0,exp:"Exactement ! Les cycles irréguliers sont fréquents chez les jeunes. Un médecin peut rassurer. 💛"}]},{ctx:"🏃",q:"Tu as tes règles et tu dois faire du sport à l'école. Que fais-tu ?",opts:[{t:"Je prétends être malade pour éviter le sport",ok:!1,exp:"Les règles ne sont pas une maladie ! Tu peux pratiquer avec une bonne protection."},{t:"Je participe normalement avec une protection adaptée",ok:!0,exp:"Exactement ! Le sport est possible pendant les règles. 🌟"},{t:"Je raconte tout à toute la classe",ok:!1,exp:"C'est une information personnelle. Tu peux participer sans tout expliquer."}]}],wf=[{scens:vl.slice(0,2),timer:30},{scens:vl.slice(0,3),timer:25},{scens:vl,timer:15}],Wn=[{q:`Je coule une fois par mois,
